DATABASE_URL="file:./dev.db"
JWT_SECRET="set-a-long-random-string"
PORT=4000

# Accounts allowed to open the /founder metrics dashboard (comma-separated
# emails). In local dev (SQLite) the seeded demo account is also allowed.
ADMIN_EMAILS="you@yourdomain.com"

# ---------------------------------------------------------------------------
# Support / contact
# ---------------------------------------------------------------------------
# Mailbox that receives customer contact-form submissions.
SUPPORT_EMAIL="support@docifydocai.com"

# ---------------------------------------------------------------------------
# Outbound email (SMTP) — used by the contact form and account emails.
# Get these from your mail provider (e.g. Zoho Mail). Leave blank in local dev:
# the mailer then logs messages to the server console instead of sending.
# NEVER commit real values — this file is an example; real secrets go in the
# untracked server/.env (and in Railway's Variables, not the repo).
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.zoho.com"
SMTP_PORT=587
SMTP_USER="support@docifydocai.com"
SMTP_PASS=""
SMTP_FROM="Docify Support <support@docifydocai.com>"

# ---------------------------------------------------------------------------
# OAuth sign-in providers — see docs/OAUTH-SETUP.md for the full runbook.
# Leave blank to disable a provider (its button then explains it isn't
# configured). In production also set:
#   OAUTH_REDIRECT_BASE="https://docifydocai.com"
#   CLIENT_ORIGIN="https://docifydocai.com"
# ---------------------------------------------------------------------------
# Google (identity sign-in only — no repository access is requested).
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <OAUTH_REDIRECT_BASE>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Code hosts (sign-in + read-only repository source in one authorization).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
BITBUCKET_CLIENT_ID=""
BITBUCKET_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Credential encryption (AES-256-GCM) for stored OAuth / API tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, provider tokens are stored in plaintext and the server warns on boot.
# ---------------------------------------------------------------------------
CREDENTIAL_KEY=""

# Set NODE_ENV=production in real deployments: enforces a strong JWT_SECRET,
# enables HSTS, and disables the simulated-OAuth demo login.
NODE_ENV="development"
